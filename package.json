{
    "name": "helix-client",
    "version": "1.0.0",
    "description": "React client for Helix 2.0",
    "main": "src/index.tsx",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc",
        "lint": "eslint ./src",
        "lint:css": "stylelint \"./src/**/*.css\"",
        "lint:unused": "knip --tags=-knipignore",
        "prestart": "pnpm initialize",
        "prebuild": "pnpm initialize",
        "preserve": "pnpm initialize",
        "pretest": "pnpm initialize",
        "pretypecheck": "pnpm initialize",
        "prelint": "pnpm initialize",
        "initialize": "mkdir -p generated && if [ ! -f generated/types.tsx ]; then cp -i type.template.tsx generated/types.tsx 2>/dev/null; else true; fi ",
        "generate": "env-cmd -f .env graphql-codegen --config codegen.yml"
    },
    "jest": {
        "setupFiles": [
            "./src/utils/setupTests.js"
        ],
        "moduleNameMapper": {
            "^.+\\.(css|scss|svg|gif|jpg|png)$": "identity-obj-proxy"
        },
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "jsx"
        ],
        "globals": {
            "NODE_ENV": "test"
        },
        "moduleDirectories": [
            "node_modules",
            "src"
        ],
        "testMatch": [
            "<rootDir>/src/**/__tests__/**/*.js?(x)",
            "<rootDir>/src/**/?(*.)(spec|test).js?(x)",
            "<rootDir>/src/**/__tests__/**/*.ts?(x)",
            "<rootDir>/src/**/?(*.)(spec|test).ts?(x)"
        ],
        "testPathIgnorePatterns": [
            "<rootDir>/src/vendor/"
        ],
        "testEnvironment": "jsdom",
        "testURL": "http://localhost",
        "transform": {
            "^.+\\.(ts|tsx)$": "babel-jest",
            "^.+\\.(js|jsx)$": "babel-jest"
        },
        "transformIgnorePatterns": [
            "[/\\\\]node_modules[/\\\\].+\\.(ts|tsx)$",
            "[/\\\\]node_modules[/\\\\].+\\.(js|jsx)$"
        ]
    },
    "devDependencies": {
        "@babel/core": "^7.12.10",
        "@babel/plugin-proposal-class-properties": "^7.12.1",
        "@babel/plugin-proposal-decorators": "^7.12.12",
        "@babel/plugin-proposal-export-namespace-from": "^7.12.1",
        "@babel/plugin-proposal-function-sent": "^7.12.1",
        "@babel/plugin-proposal-json-strings": "^7.12.1",
        "@babel/plugin-proposal-numeric-separator": "^7.12.7",
        "@babel/plugin-proposal-throw-expressions": "^7.12.1",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-syntax-import-meta": "^7.10.4",
        "@babel/plugin-transform-runtime": "^7.12.10",
        "@babel/preset-env": "^7.12.11",
        "@babel/preset-react": "^7.12.10",
        "@babel/preset-typescript": "^7.12.7",
        "@babel/register": "^7.12.10",
        "@babel/runtime": "^7.12.5",
        "@babel/runtime-corejs3": "^7.12.5",
        "@graphql-codegen/cli": "1.20.0",
        "@graphql-codegen/introspection": "1.18.1",
        "@graphql-codegen/typescript": "1.20.0",
        "@graphql-codegen/typescript-operations": "1.17.13",
        "@types/apollo-upload-client": "^14.1.0",
        "@types/mapbox-gl": "^1.13.0",
        "@types/react": "^17.0.0",
        "@types/react-dom": "^17.0.0",
        "@types/react-router-dom": "^5.1.7",
        "@types/uuid": "^8.3.0",
        "@typescript-eslint/eslint-plugin": "^4.12.0",
        "@typescript-eslint/parser": "^4.12.0",
        "@vitejs/plugin-react-swc": "^3.9.0",
        "apollo": "^2.32.0",
        "babel-core": "^7.0.0-bridge.0",
        "babel-eslint": "^10.1.0",
        "babel-jest": "^26.6.3",
        "babel-plugin-dynamic-import-node": "^2.3.3",
        "babel-plugin-graphql-tag": "^3.1.0",
        "babel-plugin-module-resolver": "^4.1.0",
        "body-parser": "^1.19.0",
        "dotenv": "^8.2.0",
        "env-cmd": "^10.1.0",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.5",
        "eslint": "^7.17.0",
        "eslint-config-airbnb": "^18.2.1",
        "eslint-config-airbnb-base": "^14.2.1",
        "eslint-import-resolver-babel-module": "^5.2.0",
        "eslint-plugin-graphql": "^4.0.0",
        "eslint-plugin-import": "^2.22.1",
        "eslint-plugin-jsx-a11y": "^6.4.1",
        "eslint-plugin-postcss-modules": "^1.1.5",
        "eslint-plugin-react": "^7.22.0",
        "eslint-plugin-react-hooks": "^4.2.0",
        "fs": "^0.0.1-security",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^26.6.3",
        "knip": "^5.36.3",
        "postcss-nested": "^4.2.1",
        "postcss-normalize": "^13.0.1",
        "postcss-preset-env": "^6.7.0",
        "react-test-renderer": "^16.14.0",
        "rollup-plugin-visualizer": "^5.14.0",
        "stylelint": "^13.8.0",
        "stylelint-config-concentric": "^2.0.2",
        "stylelint-config-recommended": "^3.0.0",
        "typescript": "^4.1.3",
        "vite": "^6.3.4",
        "vite-plugin-compression2": "^1.3.3",
        "vite-plugin-svgr": "^4.3.0",
        "vite-plugin-webfont-dl": "^3.10.4",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "dependencies": {
        "@apollo/client": "^3.5.7",
        "@hcaptcha/react-hcaptcha": "^0.3.6",
        "@julr/vite-plugin-validate-env": "^1.3.0",
        "@sentry/react": "^8.54.0",
        "@sentry/tracing": "^7.120.3",
        "@togglecorp/fujs": "^1.9.2-beta.0",
        "@togglecorp/re-map": "^0.3.0",
        "@togglecorp/toggle-form": "^0.2.0-beta.6",
        "@togglecorp/toggle-ui": "^0.18.7",
        "@turf/bbox": "^6.0.1",
        "@turf/bbox-polygon": "^6.0.1",
        "@turf/combine": "^6.0.1",
        "apollo-link": "^1.2.14",
        "apollo-link-error": "^1.1.13",
        "apollo-link-rest": "^0.8.0-beta.0",
        "apollo-link-retry": "^2.2.16",
        "apollo-upload-client": "^14.1.3",
        "core-js": "3.8.1",
        "graphql": "^15.4.0",
        "graphql-anywhere": "^4.2.7",
        "history": "^4.9.0",
        "immer": "^7.0.14",
        "mapbox-gl": "^1.13.0",
        "qs": "^6.9.4",
        "react": "^17.0.0",
        "react-dom": "^17.0.0",
        "react-icons": "^4.2.0",
        "react-markdown": "^10.1.0",
        "react-mde": "^11.0.0",
        "react-router-dom": "^5.2.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "resize-observer-polyfill": "^1.5.1",
        "turf-featurecollection": "^1.0.1",
        "uuid": "^8.3.2"
    },
    "packageManager": "pnpm@10.9.0"
}
